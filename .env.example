# Required for form delivery
RESEND_API_KEY=re_your_api_key

# Use an address on a domain verified in Resend
RESEND_FROM_EMAIL=Keyman Website <forms@keymanpublishing.com>

# All website submissions are delivered here
CONTACT_TO_EMAIL=admin@keymanpublishing.com

# Public Google Calendar appointment schedule URL
GOOGLE_APPOINTMENT_URL=https://calendar.google.com/calendar/appointments/schedules/YOUR_SCHEDULE_ID

# Optional comma-separated production origins for API origin checks
ALLOWED_ORIGINS=https://keymanpublishing.com,https://www.keymanpublishing.com
